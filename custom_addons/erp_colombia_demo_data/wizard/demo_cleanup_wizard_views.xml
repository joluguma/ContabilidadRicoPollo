<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_colombia_demo_cleanup_wizard_form" model="ir.ui.view">
        <field name="name">erp.colombia.demo.cleanup.wizard.form</field>
        <field name="model">erp.colombia.demo.cleanup.wizard</field>
        <field name="arch" type="xml">
            <form string="Eliminar datos DEMO">
                <group>
                    <field name="batch_ids" widget="many2many_tags"/>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button string="Eliminar" name="button_cleanup" type="object"
                            class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_erp_colombia_demo_cleanup_wizard" model="ir.actions.act_window">
        <field name="name">Eliminar datos DEMO</field>
        <field name="res_model">erp.colombia.demo.cleanup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
