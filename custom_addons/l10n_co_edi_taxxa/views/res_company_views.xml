<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_taxxa" model="ir.ui.view">
        <field name="name">res.company.form.taxxa</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="taxxa" string="Facturación Electrónica (TAXXA)">
                    <group>
                        <group string="Credenciales">
                            <field name="l10n_co_taxxa_base_url" placeholder="https://....taxxaapi.com/api.djson"/>
                            <field name="l10n_co_taxxa_email"/>
                            <field name="l10n_co_taxxa_password" password="True"/>
                            <field name="l10n_co_taxxa_environment"/>
                        </group>
                        <group string="Estado de la conexión">
                            <field name="l10n_co_taxxa_account"/>
                            <field name="l10n_co_taxxa_token" password="True"/>
                            <field name="l10n_co_taxxa_token_date"/>
                        </group>
                    </group>
                    <button name="action_test_taxxa_connection" type="object"
                            string="Probar conexión" class="btn-primary"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
