<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erp_colombia_demo_batch_form" model="ir.ui.view">
        <field name="name">erp.colombia.demo.batch.form</field>
        <field name="model">erp.colombia.demo.batch</field>
        <field name="arch" type="xml">
            <form string="Generador de datos DEMO">
                <header>
                    <button string="Generar" name="button_generate" type="object"
                            class="btn-primary" invisible="state == 'running'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'draft'">
                        Este módulo nunca debe instalarse en la base de datos real de
                        la empresa. Instálalo solo en una base separada dedicada a
                        pruebas (ver README.md).
                    </div>
                    <group>
                        <group string="Modo y semilla">
                            <field name="mode"/>
                            <field name="seed"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="pct_venta_contado"/>
                            <field name="pct_compra_contado"/>
                        </group>
                        <group string="Cantidades a generar">
                            <field name="n_clientes"/>
                            <field name="n_proveedores"/>
                            <field name="n_empresas"/>
                            <field name="n_productos"/>
                            <field name="n_categorias"/>
                            <field name="n_bodegas"/>
                            <field name="n_cotizaciones"/>
                            <field name="n_pedidos"/>
                            <field name="n_ordenes_compra"/>
                            <field name="n_notas_credito"/>
                            <field name="n_pagos_recibidos"/>
                            <field name="n_pagos_realizados"/>
                            <field name="dian_sample_size"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="state not in ('done', 'error')">
                        <group>
                            <field name="created_clientes"/>
                            <field name="created_proveedores"/>
                            <field name="created_productos"/>
                            <field name="created_bodegas"/>
                            <field name="created_cotizaciones"/>
                            <field name="created_pedidos"/>
                        </group>
                        <group>
                            <field name="created_facturas_venta"/>
                            <field name="created_facturas_dian"/>
                            <field name="created_notas_credito"/>
                            <field name="created_ordenes_compra"/>
                            <field name="created_facturas_compra"/>
                            <field name="created_pagos"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Validación" name="validation">
                            <field name="validation_ok" invisible="1"/>
                            <field name="validation_report" readonly="1"
                                   widget="text" class="o_field_text"/>
                        </page>
                        <page string="Log" name="log">
                            <field name="log" readonly="1" widget="text"/>
                        </page>
                        <page string="Terceros generados" name="partners">
                            <field name="partner_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vat"/>
                                    <field name="customer_rank"/>
                                    <field name="supplier_rank"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_erp_colombia_demo_batch_list" model="ir.ui.view">
        <field name="name">erp.colombia.demo.batch.list</field>
        <field name="model">erp.colombia.demo.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode"/>
                <field name="seed"/>
                <field name="state"/>
                <field name="created_clientes"/>
                <field name="created_facturas_venta"/>
                <field name="validation_ok"/>
                <field name="start_datetime"/>
            </list>
        </field>
    </record>

    <record id="action_erp_colombia_demo_batch" model="ir.actions.act_window">
        <field name="name">Generador de datos DEMO</field>
        <field name="res_model">erp.colombia.demo.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
