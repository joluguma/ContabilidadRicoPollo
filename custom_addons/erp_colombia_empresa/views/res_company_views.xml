<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_erp_colombia" model="ir.ui.view">
        <field name="name">res.company.form.erp.colombia</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="trade_name" placeholder="Nombre comercial"/>
            </field>
            <field name="vat" position="after">
                <field name="l10n_co_verification_digit" string="DV" readonly="1"
                       invisible="not l10n_co_verification_digit"/>
            </field>
        </field>
    </record>
</odoo>
